# Database connection string (Neon Postgres) - pooled for app runtime
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Direct (non-pooler) connection for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@endpoint.region.aws.neon.tech/dbname?sslmode=require"

# JWT secret for auth tokens (generate a random string for production)
JWT_SECRET="your-jwt-secret-here"
